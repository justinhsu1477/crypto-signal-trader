:443 {
    tls /etc/caddy/certs/origin-cert.pem /etc/caddy/certs/origin-key.pem

    encode zstd gzip

    # API 請求 → Spring Boot
    handle /api/* {
        reverse_proxy trading-api:8080
    }

    # 其他 → Next.js Dashboard
    handle {
        reverse_proxy web-dashboard:3000
    }
}

# gRPC — Python Monitor 從地端連入（獨立子網域，Cloudflare DNS Only 灰雲）
grpc.hook-fi.com:443 {
    tls /etc/caddy/certs/origin-cert.pem /etc/caddy/certs/origin-key.pem

    reverse_proxy h2c://trading-api:9090
}

# HTTP → HTTPS 重導向（保險用，Cloudflare 已在前端做）
:80 {
    redir https://{host}{uri} permanent
}
